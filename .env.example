# spending-ledger reads exactly one environment variable, and it is optional.
# There are no secrets, API keys or tokens in this app: never put any in this file.
# Either export it in the shell (LEDGER_DB=... npx next dev) or copy this file to .env.local,
# which Next.js loads on start. .env* files other than this template are git-ignored.

# Path of the ledger SQLite file. Default when unset: ~/.openclaw/data/ledger.sqlite
# The app WRITES to this file (manual entries, recurring rules), so point it at a scratch copy when developing.
# LEDGER_DB=/tmp/ledger-scratch.sqlite
