# Dependencies
node_modules/

# Build output (`next build` writes .next/; out/ is the static-export dir)
.next/
out/

# Generated by `next dev` / `next build`; it references .next/types, so it is build-dependent
next-env.d.ts
*.tsbuildinfo

# Environment files and secrets: never commit values (the template .env.example stays tracked)
.env
.env.*
!.env.example
secrets/
*.key
*.pem
.npmrc

# Databases and SQLite sidecar files (the live ledger is ~/.openclaw/data/ledger.sqlite, outside this repo)
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm
*.db-journal

# Receipt images and uploads (the archive is ~/.openclaw/data/receipts/, outside this repo)
/receipts/
/media/
/uploads/

# Logs
*.log
logs/
npm-debug.log*

# Python tooling caches (no Python in this repo today)
.venv/
__pycache__/
*.pyc

# Backups and editor leftovers
*.bak*
*.orig
*~
*.swp

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local Claude Code settings (this repo has no shared project skills in .claude/)
.claude/
CLAUDE.local.md
